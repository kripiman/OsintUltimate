# ==============================================================================
# OSINT ULTIMATE - Environment Variables Configuration (V13)
# ==============================================================================

# ------------------------------------------------------------------------------
# CORE SECURITY & CRYPTOGRAPHY
# ------------------------------------------------------------------------------
# Llave pública Ed25519 en formato hexadecimal (64 caracteres) utilizada para verificar 
# la firma criptográfica de los plugins dinámicos antes de cargarlos.
# ¡NUNCA USES LA LLAVE DE PRUEBA EN PRODUCCIÓN!
ED25519_PUBLIC_KEY=d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a

# ------------------------------------------------------------------------------
# C2 EXFILTRATION (WEBHOOKS)
# ------------------------------------------------------------------------------
# URL del servidor C2 (Command and Control) para la ingesta de hallazgos tácticos.
# Por seguridad (SSRF y MitM), se requiere estrictamente que empiece por HTTPS 
# y apunte a una dirección enrutable pública externa (no metadata cloud o loopbacks).
# C2_URL=https://c2.tu-dominio-seguro.com/api/v1/ingest

# Token estricto de autorización (Bearer Token) para el Webhook C2.
# Este token es obligatorio ahora para evitar la exfiltración insegura de datos de recon.
# C2_TOKEN=mi_token_secreto_super_seguro_123

# ------------------------------------------------------------------------------
# AI AUTONOMOUS ROUTING & SWARM (V13 Tiered AI)
# ------------------------------------------------------------------------------
# Tier 0: Local (Ollama)
# Endpoint de Ollama para procesamiento de inteligencia táctica y PoCs locales.
OLLAMA_URL=http://localhost:11434

# Tier 1 & 2: Cloud Providers
# Clave API para OpenAI (requerido para modelos GPT-4o o GPT-4o-mini).
# OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx

# Azure OpenAI Configuration (Alternativa para Tier 1/2)
# AZURE_OPENAI_ENDPOINT=https://tu-recurso.openai.azure.com/
# AZURE_OPENAI_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini (Tier 2 Premium & Mid Flash)
# Soporta múltiples llaves separadas por comas para rotación inteligente (V13).
# GEMINI_API_KEYS=AIzaSyA..., AIzaSyB..., AIzaSyC...

# Anthropic Claude (Tier 2 Premium)
# ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxx

# Límites de Tokens para el Swarm
MAX_TOKENS=50000

# ------------------------------------------------------------------------------
# STEALTH INFRASTRUCTURE (DIGITAL OCEAN)
# ------------------------------------------------------------------------------
# Token de acceso personal de DigitalOcean para aprovisionar nodos efímeros 
# (stealth mode: --stealth) que actúan como exit nodes de OSINT.
# DIGITALOCEAN_TOKEN=dop_v1_xxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# RESOURCE MANAGEMENT & PERFORMANCE
# ------------------------------------------------------------------------------
# Límites de memoria en MB para el monitor de salud del motor.
SOFT_MEMORY_LIMIT=600
HARD_MEMORY_LIMIT=900

# Concurrencia por defecto para el pipeline de escaneo.
DEFAULT_CONCURRENCY=10
