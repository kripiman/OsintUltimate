# 🔱 OsintUltimate Oracle Cloud V14.2 - Sovereign Environment Configuration
# Optimized for: Oracle ARM Ampere (2 cores, 12GB - 4 cores, 24GB)

# --- 1. SOVEREIGN INFRASTRUCTURE (Managed Egress) ---
DATABASE_URL=postgres://osintuser:WENYANULTRA_SECURE_PASS@localhost:5432/osintdb
DIGITALOCEAN_TOKEN=YOUR_DO_TOKEN_HERE
# Replace with the numeric ID or fingerprint of your SSH Key in DigitalOcean
DO_SSH_KEY_ID=YOUR_SSH_KEY_ID_HERE

# Proxy Mode: hysteria (UDP High-Speed) is recommended for Oracle ARM egress
PROXY_MODE=hysteria
PROXY_POOL_SIZE=3

# --- 2. AI ORCHESTRATION (Tiered Reasoning) ---
# Local tier (Ollama)
OLLAMA_URL=http://localhost:11434

# Premium tier (Tactical Decision Making)
# POPULATE THESE TO ENABLE MULTI-AGENT SWARM
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Kimi Code Platform (K2.6)
# Obtenlo en: https://www.kimi.com/code/console
KIMI_API_KEY=
# kimi-for-coding es el alias estable recomendado, pero puedes forzar otro si es necesario
KIMI_MODEL=kimi-for-coding

# Claude Code CLI (Local hybrid execution)
CLAUDE_CODE_ENABLED=true

# Sovereign Agent Sync Token (32-byte hex)
# GENERATED: e6672d294575fd25fb8967f88d27e5e8c82f49cd4aecaa9ee363afddc16c826d
MCP_TOKEN=e6672d294575fd25fb8967f88d27e5e8c82f49cd4aecaa9ee363afddc16c826d

# --- 3. OSINT ENGINES (Reconnaissance) ---
SHODAN_API_KEY=
NETLAS_API_KEY=
CHAOS_API_KEY=
SECURITYTRAILS_API_KEY=
CRIMINALIP_API_KEY=

# --- 4. VULNERABILITY INTELLIGENCE ---
# Highly recommended to avoid NVD rate limiting during automated scans
NVD_API_KEY=
GREYNOISE_API_KEY=

# --- 5. OOB & REMOTE VERIFICATION (Interactsh) ---
# Critical for Anti-Hallucination Layer 4 (OOB Verification)
INTERACTSH_SERVER_URL=interact.sh
INTERACTSH_TOKEN=

# Caido Integration (Optional)
CAIDO_API_KEY=
CAIDO_API_URL=http://localhost:8080/graphql

# --- 6. C2 & TELEMETRY ---
# Tactical Webhook Sink & Notification
DISCORD_WEBHOOK_URL=
C2_URL=
C2_TOKEN=

# --- 7. HARDENING & RESOURCE LIMITS (Oracle ARM 24GB Optimization) ---
# Optimized limits for ARM A1 architecture
SOFT_MEMORY_LIMIT=16000
HARD_MEMORY_LIMIT=20000
DEFAULT_CONCURRENCY=50
MAX_TOKENS=500000

# --- 8. LOGGING & DEBUG ---
RUST_LOG=info
 
# --- 10. TOOL BINARY PATHS (P0 Arsenal) ---
# Caminos para binarios y wordlists del arsenal de explotación (Oracle ARM compatible)
SHUFFLEDNS_PATH=/usr/local/bin/shuffledns
MASSDNS_PATH=/usr/local/bin/massdns
SHUFFLEDNS_RESOLVERS=$HOME/.local/share/osint-ultimate/wordlists/resolvers.txt
SHUFFLEDNS_WORDLIST=$HOME/.local/share/osint-ultimate/wordlists/n0kovo-subdomains.txt
S3SCANNER_PATH=/usr/local/bin/s3scanner
S3SCANNER_WORDLIST=$HOME/.local/share/osint-ultimate/wordlists/seclists/Discovery/Cloud/cloud_buckets_full.txt
KXSS_PATH=/usr/local/bin/kxss
GHAURI_PATH=/usr/local/bin/ghauri
SSRFMAP_PATH=/opt/ssrfmap/ssrfmap.py
NOSQLMAP_PATH=/opt/nosqlmap/nosqlmap.py
GOPHERUS_PATH=/opt/gopherus/gopherus.py
CLAIRVOYANCE_WORDLIST=$HOME/.local/share/osint-ultimate/wordlists/seclists/Discovery/Web-Content/graphql.txt

# --- 9. MOBILE SECURITY (MobSF) ---
# Mobile Security Framework (MobSF)
MOBSF_URL=http://localhost:8000
MOBSF_API_KEY=status_ga_secret_key
MOBSF_TIMEOUT_SECS=1200
